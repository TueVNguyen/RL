+class _GroupedAdapterLinear(nn.Module):
+    """Parameter container exposing a .weight like Linear for adapter export."""
+
+    def __init__(self, num_experts: int, out_features: int, in_features: int, *, dtype, device):
+        super().__init__()
+        self.weight = nn.Parameter(torch.empty(num_experts, out_features, in_features, dtype=dtype, device=device))
+
+
+def _normalize_lora_dtype(dtype: Optional[Union[str, torch.dtype]]) -> Optional[torch.dtype]:
+    if dtype is None or isinstance(dtype, torch.dtype):
+        return dtype
+    if not isinstance(dtype, str):
+        raise TypeError(f"Expected torch.dtype, str, or None for LoRA dtype, got {type(dtype)}")
+
+    normalized = dtype.removeprefix("torch.").lower()
+    if normalized in {"none", "null"}:
+        return None
+    if normalized in {"bfloat16", "bf16", "bf16-mixed"}:
+        return torch.bfloat16
+    if normalized in {"float16", "fp16", "half", "fp16-mixed"}:
+        return torch.float16
+    if normalized in {"float32", "fp32", "float"}:
+        return torch.float32
+
+    # Adapter weights cannot be allocated in TE fp8 wrapper dtypes.
+    if "float8" in normalized or "fp8" in normalized:
+        return torch.bfloat16
+
+    raise ValueError(f"Unsupported LoRA dtype string: {dtype}")
+
+
+class GroupedLinearAdapter(nn.Module):
+    """Per-expert LoRA adapter for TE grouped expert linear layers.
+
+    The base TE grouped linear keeps the fast grouped GEMM path. This adapter adds
+    a low-rank delta with separate A/B matrices for each local expert.
+    """
+
+    def __init__(
+        self,
+        num_experts: int,
+        in_features: int,
+        out_features: int,
+        dim: int,
+        base_linear_name: str,
+        alpha: int = 32,
+        dropout: float = 0.0,
+        dropout_position: Literal["pre", "post"] = "pre",
+        lora_A_init_method: Literal["xavier", "uniform"] = "xavier",
+        lora_B_init_method: Literal["zero", "xavier", "uniform"] = "zero",
+        lora_dtype: Optional[torch.dtype] = None,
+        base_weight: Optional[torch.Tensor] = None,
+    ) -> None:
+        super().__init__()
+        self.num_experts = num_experts
+        self.in_features = in_features
+        self.out_features = out_features
+        self.dim = dim
+        self.alpha = alpha
+        self.scale = alpha / dim
+        self.base_linear_name = base_linear_name
+        self.dropout_position = dropout_position
+
+        lora_dtype = _normalize_lora_dtype(lora_dtype)
+
+        if base_weight is None:
+            device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+            dtype = lora_dtype or torch.get_default_dtype()
+        else:
+            device = base_weight.device
+            dtype = lora_dtype or _normalize_lora_dtype(base_weight.dtype) or torch.get_default_dtype()
+
+        self.linear_in = _GroupedAdapterLinear(num_experts, dim, in_features, dtype=dtype, device=device)
+        self.linear_out = _GroupedAdapterLinear(num_experts, out_features, dim, dtype=dtype, device=device)
+
+        if lora_A_init_method == "xavier":
+            for expert_idx in range(num_experts):
+                nn.init.xavier_uniform_(self.linear_in.weight.data[expert_idx])
+        else:
+            for expert_idx in range(num_experts):
+                nn.init.kaiming_uniform_(self.linear_in.weight.data[expert_idx], a=math.sqrt(5))
+
+        if lora_B_init_method == "zero":
+            self.linear_out.weight.data.fill_(0)
+        elif lora_B_init_method == "xavier":
+            for expert_idx in range(num_experts):
+                nn.init.xavier_uniform_(self.linear_out.weight.data[expert_idx])
+        else:
+            for expert_idx in range(num_experts):
+                nn.init.kaiming_uniform_(self.linear_out.weight.data[expert_idx], a=math.sqrt(5))
+
+        self.dropout = nn.Dropout(p=dropout) if dropout > 0.0 else nn.Identity()
+        assert dropout_position in ["pre", "post"], dropout_position
+
+    def forward(self, x: torch.Tensor, tokens_per_expert: list[int]) -> torch.Tensor:
+        if self.dropout_position == "pre":
+            x = self.dropout(x)
+
+        chunks = torch.split(x, tokens_per_expert, dim=0)
+        outputs = []
+        for expert_idx, chunk in enumerate(chunks):
+            if chunk.numel() == 0:
+                continue
+            hidden = torch.matmul(chunk, self.linear_in.weight[expert_idx].t())
+            out = torch.matmul(hidden, self.linear_out.weight[expert_idx].t())
+            outputs.append(out)
+
+        if outputs:
+            y = torch.cat(outputs, dim=0)
+        else:
+            y = x.new_zeros((0, self.out_features))
+
+        if self.dropout_position == "post":
+            y = self.dropout(y)
+        y = y * self.scale
+
+        # Keep all expert adapter parameters in the autograd graph even when an
+        # expert receives no tokens in this microbatch.
+        return y + (self.linear_in.weight.sum() + self.linear_out.weight.sum()) * 0.0
+
+    def sharded_state_dict(self, prefix: str = "", sharded_offsets: Tuple = (), metadata: Optional[dict] = None):
+        state_dict = {
+            "linear_in.weight": self.linear_in.weight,
+            "linear_out.weight": self.linear_out.weight,
+        }
+        return make_sharded_tensors_for_checkpoint(state_dict, prefix, {}, sharded_offsets)
+
+
+class LoRAGroupedLinear(AdapterWrapper):
+    """LoRA wrapper for TE grouped expert linear layers."""
+
+    def forward(self, x: torch.Tensor, tokens_per_expert: list[int], *args: Any, **kwargs: Any):
+        linear_output, bias = self.to_wrap(x, tokens_per_expert, *args, **kwargs)
+        if not self._adapter_enabled:
+            return linear_output, bias
+        adapter_output = self.adapter(x.contiguous(), tokens_per_expert)
+        adapter_output = adapter_output.reshape(linear_output.shape)
+        return linear_output + adapter_output, bias
+
+
